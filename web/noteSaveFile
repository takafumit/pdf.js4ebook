// 2025/11/10 ファイル保存形式（サーバなし）
function downloadNotesAndHighlights() {
  const notesData = localStorage.getItem(STORAGE_KEY);
  const highlightsData = localStorage.getItem(HIGHLIGHT_KEY);

  const blob = new Blob(
    [JSON.stringify({ notes: notesData, highlights: highlightsData }, null, 2)],
    { type: "application/json" }
  );

  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url;
  a.download = "pdf_notes.json";
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  URL.revokeObjectURL(url);
}

