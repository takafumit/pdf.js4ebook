// フリーハイライト機能
// 2025/11/17 フリーハイライト機能
document.getElementById("addFreeHighlightButton").addEventListener("click", () => {
  freeHighlightMode = !freeHighlightMode;

  if (freeHighlightMode) {
    document.body.style.cursor = "crosshair";
  } else {
    document.body.style.cursor = "default";
  }
});

document.getElementById("noteLayer").addEventListener("mousedown", e => {
  if (!freeHighlightMode) return;

  const pageDiv = e.target.closest(".page");
  if (!pageDiv) return;

  const pageNum = parseInt(pageDiv.dataset.pageNumber);
  const pageView = PDFViewerApplication.pdfViewer.getPageView(pageNum - 1);
  const rect = pageView.div.getBoundingClientRect();

  const domX = e.clientX - rect.left;
  const domY = e.clientY - rect.top;
  const [pdfX, pdfY] = pageView.viewport.convertToPdfPoint(domX, domY);

  createFreeHighlight(pdfX, pdfY, pageNum);

  freeHighlightMode = false;
  document.body.style.cursor = "default";
});

function createFreeHighlight(pdfX, pdfY, pageNum) {
  const pageView = PDFViewerApplication.pdfViewer.getPageView(pageNum - 1);
  const noteLayer = document.getElementById("noteLayer");
  const colorInfo = highlightColors[currentHighlightColor];

  const highlight = document.createElement("div");
  highlight.className = "highlight";
  highlight.dataset.page = pageNum;
  highlight.dataset.color = currentHighlightColor;
  highlight.dataset.text = ""; // PDFテキストに紐付けない
  highlight.dataset.id = `hl-${Date.now()}-${Math.random().toString(36).slice(2, 8)}`;

  highlight.dataset.x = pdfX;
  highlight.dataset.y = pdfY;
  highlight.dataset.w = 80;   // 初期サイズ
  highlight.dataset.h = 30;

  const [viewX, viewY] = pageView.viewport.convertToViewportPoint(pdfX, pdfY);

  highlight.style.position = "absolute";
  highlight.style.left = `${viewX + pageView.div.offsetLeft}px`;
  highlight.style.top = `${viewY + pageView.div.offsetTop}px`;
  highlight.style.width = `${80 * pageView.viewport.scale}px`;
  highlight.style.height = `${30 * pageView.viewport.scale}px`;
  highlight.style.backgroundColor = colorInfo.bg;
  highlight.style.border = `1px solid ${colorInfo.border}`;
  highlight.style.cursor = "move";

  // 選択処理（既存）
  highlight.onclick = ev => {
    ev.stopPropagation();
    select(highlight);
  };

  noteLayer.appendChild(highlight);
  doOp(OP.create(highlight, $("noteLayer")));

  enableHighlightDrag(highlight);
  scheduleSave();
}

function enableHighlightDrag(hl) {
  let startX, startY, fromLeft, fromTop;

  hl.onmousedown = e => {
    if (e.button !== 0) return;

    commit(hl);

    const cs = getComputedStyle(hl);
    startX = e.clientX;
    startY = e.clientY;
    fromLeft = parseFloat(cs.left);
    fromTop = parseFloat(cs.top);

    let moved = false; // ← 追加

    document.onmousemove = ev => {
      moved = true; // ← 動いた
      move(ev);
    };

    document.onmouseup = ev => {
      document.onmousemove = document.onmouseup = null;

      if (!moved) {
        // ← 動いてなければクリック扱い
        select(hl);
        return;
      }

      // ← 動いてたらドラッグ扱い
      const pageNum = parseInt(hl.dataset.page);
      const { x, y, w, h } = domToPdf(hl, pageNum);

      hl.dataset.x = x;
      hl.dataset.y = y;
      hl.dataset.w = w;
      hl.dataset.h = h;

      scheduleSave();
    };

    e.stopPropagation();
  };

  const move = e => {
    hl.style.left = `${fromLeft + e.clientX - startX}px`;
    hl.style.top = `${fromTop + e.clientY - startY}px`;
  };

  const up = () => {
    document.onmousemove = document.onmouseup = null;

    const pageNum = parseInt(hl.dataset.page);
    const { x, y, w, h } = domToPdf(hl, pageNum);

    hl.dataset.x = x;
    hl.dataset.y = y;
    hl.dataset.w = w;
    hl.dataset.h = h;

    scheduleSave();
  };
}

